[Unit]
Description=Duris persistence health
# Add an OnFailure= unit connected to the custodian's existing alerting service.
Conflicts=duris-backup-backup.service duris-backup-drill.service

[Service]
Type=oneshot
User=duris
Group=duris
UMask=0077
WorkingDirectory=/opt/duris
Environment=BACKUP_ENV_FILE=/etc/duris/backup.env
ExecStart=/opt/duris/scripts/backup_pfiles.sh status --require-drill
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/duris
TimeoutStartSec=1h
