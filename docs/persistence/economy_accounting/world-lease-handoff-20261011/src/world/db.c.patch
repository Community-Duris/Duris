+			    !current_global(&globals, context) || globals > lower_outer)
+				return false;
+			lower_outer -= globals;
+			size_t lower_full = 0, lower_supplement = 0, lower_initial = 0;
+			size_t preentry = lower_outer;
+			if (!native_mobile_birth_fill_master_spellbook_source_frame_bytes(&lower_full) ||
+			    !native_mobile_birth_fill_master_spellbook_source_supplement_frame_bytes(&lower_supplement) ||
+			    !native_mobile_birth_fill_master_spellbook_initial_inline_bytes(&lower_initial) ||
+			    lower_supplement > lower_full ||
+			    !ordinary_item_constructor_budget::add(preentry, globals) ||
+			    !ordinary_item_constructor_budget::add(preentry, lower_full) ||
+			    !ordinary_item_constructor_budget::add(preentry, lower_initial) ||
+			    !reserve(preentry, context) ||
+			    !ordinary_item_constructor_budget::add(lower_outer, lower_supplement))
+			    return false;
+			// INITIAL covers pre-first-callback construction only. The unchanged
+			// child admits its original physical work/Source; retain only the
+			// genuine positive Source supplement through that child's callbacks.
+
+			int pages = 0;
+			bool filled = false;
+			{
+				ordinary_item_constructor_budget::lower_call lower(budget);
+				filled = native_mobile_birth_fill_master_spellbook_bounded(
+					obj, &pages, ordinary_item_constructor_budget::global,
+					ordinary_item_constructor_budget::relay, &budget,
+					lower_outer);
+			}
+			// Preserve actual descriptor ownership even when the provider refuses.
+			if (!had_spell_description)
+				s.allocated_spell_description = find_spell_description(obj);
+			if (!filled || !budget.request())
+				return false;
+		}
+        // convertObj's instrument/totem snprintf is bounded by its actual
+        // MAX_STRING_LENGTH buffer. str_dup can allocate at most that many
+        // bytes including NUL, plus the actual MEMCHK allocation header.
+        // The old shared name remains global-owned across replacement.
+        constexpr size_t conversion_heap =
+            MAX_STRING_LENGTH * sizeof(char) + birth_mobile_malloc_header();
+        if (!budget.request((obj->type == ITEM_INSTRUMENT || obj->type == ITEM_TOTEM) ?
+                                conversion_heap : 0))
+            return false;
+        convertObj(obj);
+        // The replacement now belongs to this candidate and its real header
+        // census. Drop the prospective bound before another native operation.
+        if (!budget.request())
+            return false;
+		if (obj_index != s.index || obj_index[nr].virtual_number != s.vnum ||
+		    obj_index[nr].pos != s.position || obj_index[nr].func.obj != s.original_proc)
+		{
+			candidate.discard_unadmitted();
+			return false;
+		}
+		s.preparation_completed = true;
+		obj->reset_order_state = 3;
+		output->state_ = candidate.state_;
+		candidate.state_ = nullptr;
+		return true;
+	}
+	catch (const template_read_failure &failure)
+	{
+		budget.request_owner.fail(static_cast<int>(failure.error));
+		candidate.discard_unadmitted();
+		return false;
+	}
+	catch (const std::bad_alloc &)
+	{
+		budget.request_owner.fail(ENOMEM);
+		candidate.discard_unadmitted();
+		return false;
+	}
+	catch (...)
+	{
+		candidate.discard_unadmitted();
+		return false;
+	}
+#endif
+}
+
+
+bool quest_mobile_native_item_stage::prepare_retaining_world_flat_bounded(
+    int nr, int type, uint64_t reserved_uid,
+    const quest_mobile_native_flat_factory_scope &scope,
+    quest_mobile_native_item_stage *output, bool (*current_global)(size_t *, void *) noexcept,
+    bool (*reserve)(size_t, void *) noexcept, void *context, size_t outer_live,
+    bool *attempted) noexcept
+{
+    if (!output || output->state_ || !attempted || *attempted || !current_global || !reserve)
+    {
+        errno = EINVAL;
+        return false;
+    }
+#if !defined(_GLIBCXX_RELEASE) || _GLIBCXX_RELEASE != 13 || !defined(_GLIBCXX_USE_CXX11_ABI) || \
+    !_GLIBCXX_USE_CXX11_ABI || defined(_GLIBCXX_DEBUG)
+    errno = ENOTSUP;
+    return false;
+#else
+    struct retained_transfer
+    {
+        implementation *&candidate, *&output;
+        ~retained_transfer() noexcept
+        {
+            if (candidate)
+            {
+                output = candidate;
+                candidate = nullptr;
+            }
+        }
+    };
+    // These are this wrapper's actual declaration/INLINE carriers. The
+    // existing constructor retains its original conservative admission. This
+    // working draft is not a complete Source export: the independent copy and
+    // constructor descendant maps are joined before final candidate sealing.
+    const size_t copy_source = scope.copy_source_frames();
+    const size_t scope_observer_source = scope.retained_source_frames();
+    const size_t stage_observer_source = world_retained_observation_source_frames();
+    const size_t match_source = world_factory_match_source_frames();
+    if (!copy_source || !scope_observer_source || !stage_observer_source || !match_source)
+        return false;
+    const size_t frames =
+        sizeof(nr) + sizeof(type) + sizeof(reserved_uid) + sizeof(&scope) +
+        sizeof(output) + sizeof(current_global) + sizeof(reserve) + sizeof(context) +
+        sizeof(outer_live) + sizeof(attempted) + sizeof(size_t) +
+        sizeof(ordinary_item_constructor_budget) + sizeof(quest_mobile_native_item_stage) +
+        sizeof(retained_transfer) + 3 * sizeof(size_t) + sizeof(bool) +
+        sizeof(void *) + sizeof(bool) +
+        // Actual passive-query locals/results and selected copy/census/match
+        // descendants. No whole NPC/current envelope is subtracted as credit.
+        // Four caller values plus four declared scalar getter results; the
+        // match getter additionally owns current_source/constexpr selected and
+        // the selected current getter's returned size_t: three more N.
+        11 * sizeof(size_t) + copy_source + scope_observer_source +
+        stage_observer_source + match_source +
+        sizeof(size_t *) + sizeof(size_t) + sizeof(bool);
+    size_t entry = outer_live;
+    if (!cold_birth_add(entry, frames) || !reserve(entry, context))
+        return false;
+    ordinary_item_constructor_budget budget{ current_global, reserve, context };
+    quest_mobile_native_item_stage candidate;
+    retained_transfer transfer{ candidate.state_, output->state_ };
+    budget.candidate = &candidate;
+    if (!budget.init(entry))
+        return false;
+    size_t live = 0;
+    if (!budget.full_private_prefix(&live) ||
+        !scope.current_bounded(reserve, context, live))
+        return false;
+    // During the lower call its private candidate is not in the registered
+    // ROOT census. The wrapper's empty stage has no heap to count there.
+    const bool prepared = prepare_impl_world_flat_bounded(
+        nr, type, reserved_uid, scope, &candidate, current_global, reserve, context,
+        live, attempted);
+    if (!candidate.state_)
+        return false;
+    candidate.state_->flat_factory = true;
+    // The inner controller has returned; the wrapper now owns the one real
+    // surviving candidate. The initially-empty registered output is populated
+    // only by transfer on exit, including every copy/admission refusal.
+    size_t copy_heap = scope.retained_heap_bytes();
+    if (!copy_heap || !budget.request(copy_heap))
+        return false;
+    try
+    {
+        candidate.state_->flat_scope =
+            std::shared_ptr<const quest_mobile_native_flat_factory_scope>(
+                new quest_mobile_native_flat_factory_scope(scope));
+    }
+    catch (const std::bad_alloc &)
+    {
+        errno = ENOMEM;
+        return false;
+    }
+    catch (...)
+    {
+        errno = EIO;
+        return false;
+    }
+    return prepared && budget.full_private_prefix(&live) &&
+           scope.current_bounded(reserve, context, live) &&
+           candidate.flat_factory_matches(scope.root_, scope.source_);
 #endif
 }
 
