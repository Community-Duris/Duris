+// The exact installed-projection observer, with its existing full Source and
+// outer selected-shared-pointer INITIAL admitted before the real load. The
+// caller supplies its already-live declarations/objects; callback implementations
+// configured outside this LOCAL cut remain the selecting caller's responsibility.
+bool quest_mobile_native_birth_owner::capture_flat_reset_projection_admitted(
+	critical_operation_id *lineage, critical_operation_id *epoch, size_t caller_live) noexcept
+{
+	if (!lineage || !epoch || lineage == epoch)
+		return false;
+	size_t charge_source = 0, authority_source = 0, authority_initial = 0;
+	size_t request = caller_live;
+	bool observed = false;
+	constexpr size_t own =
+		// Two output parameters, caller_live, return and observed; four named Ns
+		// and the two actual constexpr local declarations below.
+		2 * sizeof(void *) + 7 * sizeof(size_t) + 3 * sizeof(bool);
+	constexpr size_t queries =
+		quest_mobile_native_birth_charge_local_source_query_frame_bytes() +
+		economic_gameplay_authority::capture_flat_reset_projection_source_query_frame_bytes() +
+		economic_gameplay_authority::capture_flat_reset_projection_initial_query_frame_bytes();
+	// Pure bootstrap observes no projection or configured callback. Its query
+	// declarations are part of this first real request, as in the selected NPC
+	// ordinary-flat caller. No old observer working_bytes margin is borrowed.
+	if (!quest_mobile_native_birth_charge_local_source_frame_bytes(&charge_source) ||
+	    !add_bytes(request, own) || !add_bytes(request, queries) ||
+	    !add_bytes(request, charge_source) || !charge(request))
+		return false;
+	if (!economic_gameplay_authority::capture_flat_reset_projection_source_frame_bytes(
+		    &authority_source) ||
+	    !economic_gameplay_authority::capture_flat_reset_projection_initial_inline_bytes(
+		    &authority_initial) ||
+	    !add_bytes(request, authority_source) || !add_bytes(request, authority_initial) ||
+	    !charge(request))
+		return false;
+	observed = economic_gameplay_authority::capture_flat_reset_projection(lineage, epoch);
+	// The authority's selected object and named load/disposal descendants have
+	// died. Query result scalars still live; remove only the exact child bound.
+	request -= authority_source;
+	request -= authority_initial;
+	const bool recensused = charge(request);
+	return observed && recensused;
+}
