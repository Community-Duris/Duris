+struct critical_fresh_bank_submission_owner::workspace
+{
+	const critical_command &input;
+	reserve_fn reserve;
+	void *guard;
+	size_t outer, retained_source;
+	std::unique_lock<std::mutex> lock;
+	const critical_command *command = nullptr;
+	std::string identity, fence_key;
+	std::vector<uint8_t> encoded, equal_left, equal_right;
+	std::unique_ptr<operation_state> state;
+	decltype(operations)::iterator found;
+	decltype(completed_cache)::iterator completed;
+	decltype(fences)::iterator fence_found;
+	native_identity_queue *fence_queue = nullptr;
+	size_t partial = 0, current = 0, full = 0, exclusive = 0;
+	size_t request = 0, fresh = 0, extra = 0, retained = 0, key_index = 0;
+	size_t child_source = 0, child_initial = 0, child_supplement = 0, child_outer = 0;
+	bool borrowed = false, denied = false, inserted = false, admission_queued = false;
+	bool supplied_time = false, sql_pair = false;
+	workspace(const critical_command &value, reserve_fn callback, void *context,
+		  size_t caller_outer, size_t source) noexcept
+		: input(value)
+		, reserve(callback)
+		, guard(context)
+		, outer(caller_outer)
+		, retained_source(source)
+		, lock(coordinator_mutex, std::defer_lock)
+	{
+	}
+	~workspace()
+	{
+		// This runs before the actual lock member is destroyed. No callback,
+		// census or dangling command access is performed during cleanup.
+		if (borrowed)
+			critical_fresh_bank_submission_owner::end_borrow(*this);
+	}
+};
+
+bool critical_fresh_bank_submission_owner::reserve_locked(size_t partial, void *opaque) noexcept
+{
+	auto &work = *static_cast<workspace *>(opaque);
+	if (work.lock.mutex() != &coordinator_mutex || !work.lock.owns_lock() ||
+	    !room_coordinator_current_storage_bytes_locked(&work.current))
+	{
+		work.denied = true;
+		return false;
+	}
+	if (work.borrowed ? !currency_transaction_fresh_budget_scope_owner::refresh_borrow(
+				    &work, work.reserve, work.guard, work.current) :
+			    !currency_transaction_fresh_budget_scope_owner::begin_borrow(
+				    &work, work.reserve, work.guard, work.current))
+	{
+		work.denied = true;
+		return false;
+	}
+	work.borrowed = true;
+	work.full = partial;
+	if (!room_storage_add(work.full, work.current) ||
+	    !currency_transaction_fresh_budget_scope_owner::exclusive_prefix(
+		    work.guard, work.reserve, work.full, &work.exclusive) ||
+	    !work.reserve(work.exclusive, work.guard))
+	{
+		work.denied = true;
+		return false;
+	}
+	return true;
+}
+
+bool critical_fresh_bank_submission_owner::prefix(workspace &work, size_t extra) noexcept
+{
+	work.partial = work.outer;
+	if (!room_storage_add(work.partial, sizeof(workspace)) ||
+	    !room_storage_add(work.partial, sizeof(critical_command)) ||
+	    !room_storage_add(work.partial, work.retained_source) ||
+	    (work.command && !room_storage_command(work.partial, *work.command)) ||
+	    !room_storage_string(work.partial, work.identity) ||
+	    !room_storage_string(work.partial, work.fence_key) ||
+	    !room_storage_add(work.partial, work.encoded.capacity()) ||
+	    !room_storage_add(work.partial, work.equal_left.capacity()) ||
+	    !room_storage_add(work.partial, work.equal_right.capacity()) ||
+	    (work.state && (!room_storage_add(work.partial, sizeof(operation_state)) ||
+			    !room_storage_command(work.partial, work.state->command))) ||
+	    !room_storage_add(work.partial, extra))
+	{
+		work.denied = true;
+		return false;
+	}
+	return true;
+}
+bool critical_fresh_bank_submission_owner::admit(workspace &work, size_t extra) noexcept
+{
+	return prefix(work, extra) && reserve_locked(work.partial, &work);
+}
+bool critical_fresh_bank_submission_owner::end_borrow(workspace &work) noexcept
+{
+	if (!work.borrowed)
+		return true;
+	if (!currency_transaction_fresh_budget_scope_owner::end_borrow(&work))
+	{
+		work.denied = true;
+		return false;
+	}
+	work.borrowed = false;
+	return true;
+}
+critical_submit_result
+critical_fresh_bank_submission_owner::finish(workspace &work,
+					     critical_submit_result result) noexcept
+{
+	return end_borrow(work) ? result : critical_submit_result::overloaded;
+}
+critical_submit_result critical_fresh_bank_submission_owner::rollback(workspace &work) noexcept
+{
+	// The complete cleanup allowance is retained before the first mutation.
+	// No refusal callback is invoked while recovering a partial insertion.
+	if (work.inserted)
+	{
+		work.found = operations.find(work.identity);
+		if (work.found != operations.end())
+		{
+			remove_fences(work.identity, work.found->second->command);
+			operations.erase(work.found);
+		}
+		pending_admission.erase(std::remove(pending_admission.begin(),
+						    pending_admission.end(), work.identity),
+					pending_admission.end());
+		if (work.admission_queued)
+			pending_admission_bytes -= work.retained;
+		work.inserted = false;
+		work.admission_queued = false;
+	}
+	work.state.reset();
+	++health.overloads;
+	// Original rollback increments overloads; it does not run update_depth.
+	return finish(work, critical_submit_result::overloaded);
+}
+bool critical_fresh_bank_submission_owner::encode(workspace &work, const critical_command &command,
+						  std::vector<uint8_t> &output) noexcept
+{
+	if (!admit(work, 3 * critical_command_startup_codec_complete_source_query_frame_bytes()) ||
+	    !critical_command_startup_codec_complete_source_frame_bytes(&work.child_source) ||
+	    !critical_command_startup_codec_initial_inline_bytes(&work.child_initial) ||
+	    !critical_command_startup_codec_source_supplement_frame_bytes(&work.child_supplement))
+		return false;
+	if (!prefix(work))
+		return false;
+	work.request = work.partial;
+	if (!room_storage_add(work.request, work.child_source) ||
+	    !room_storage_add(work.request, work.child_initial))
+	{
+		work.denied = true;
+		return false;
+	}
+	if (!reserve_locked(work.request, &work))
+		return false;
+	work.child_outer = work.partial;
+	if (!room_storage_add(work.child_outer, work.child_supplement))
+	{
+		work.denied = true;
+		return false;
+	}
+	return critical_command_encode_bounded(command, &output, reserve_locked, &work,
+					       work.child_outer) ==
+	       critical_command_codec_result::ok;
+}
+bool critical_fresh_bank_submission_owner::equal(workspace &work, const critical_command &left,
+						 const critical_command &right) noexcept
+{
+	return encode(work, left, work.equal_left) && encode(work, right, work.equal_right) &&
+	       work.equal_left == work.equal_right;
+}
+
+critical_submit_result critical_fresh_bank_submission_owner::submit_bounded(
+	const critical_command &original, bool retain_until_publication, reserve_fn reserve,
+	void *guard, size_t outer) noexcept
+{
+	if (!reserve || original.type != critical_command_type::account_bank ||
+	    original.schema_version != CRITICAL_COMMAND_ACCOUNTING_SCHEMA_VERSION ||
+	    (original.publication_required && !retain_until_publication))
+		return critical_submit_result::invalid;
+	size_t own_source = 0, initial = 0, entry = outer;
+	// Allocation-free bootstrap metadata. Caller full/INITIAL preentry is not
+	// treated as retained credit; this real root owns its retained Source.
+	if (!retained_source_frame_bytes(&own_source) || !initial_inline_bytes(&initial) ||
+	    !room_storage_add(entry, own_source) || !room_storage_add(entry, initial) ||
+	    !reserve(entry, guard))
+		return critical_submit_result::overloaded;
+	workspace work(original, reserve, guard, outer, own_source);
+	try
+	{
+		work.lock.lock();
+		if (!admit(work))
+			return rollback(work);
+		if (!critical_command_fresh_copy_request_bytes(original, &work.fresh) ||
+		    !admit(work, work.fresh))
+			return rollback(work);
+		// Actual COPY construction, unlike original by-value pre-lock entry.
+		critical_command command(original);
+		work.command = &command;
+		command.publication_required = retain_until_publication;
+		work.supplied_time = command.accepted_at_usec != 0;
+		if (!work.supplied_time)
+			command.accepted_at_usec = wall_now_usec();
+		if (!critical_command_envelope_valid(command))
+			return finish(work, critical_submit_result::invalid);
+		work.sql_pair = extension_validator_callback ==
+				economic_command_admission_supported;
+		if (!work.sql_pair &&
+		    extension_validator_callback != economic_flatfile_command_admission_supported)
+			return finish(work, critical_submit_result::invalid);
+		if (!admit(work, 3 * economic_bank_command_admission_source_query_frame_bytes()) ||
+		    !economic_bank_command_admission_source_frame_bytes(&work.child_source) ||
+		    !economic_bank_command_admission_initial_inline_bytes(&work.child_initial) ||
+		    !economic_bank_command_admission_source_supplement_frame_bytes(
+			    &work.child_supplement) ||
+		    !prefix(work))
+			return rollback(work);
+		work.request = work.partial;
+		if (!room_storage_add(work.request, work.child_source) ||
+		    !room_storage_add(work.request, work.child_initial) ||
+		    !reserve_locked(work.request, &work))
+			return rollback(work);
+		work.child_outer = work.partial;
+		if (!room_storage_add(work.child_outer, work.child_supplement))
+			return rollback(work);
+		if (!(work.sql_pair ? economic_bank_command_admission_supported_bounded(
+					      command, reserve_locked, &work, work.child_outer) :
+				      economic_flatfile_bank_command_admission_supported_bounded(
+					      command, reserve_locked, &work, work.child_outer)))
+			return work.denied ? rollback(work) :
+					     finish(work, critical_submit_result::invalid);
+		if (!health.initialized || !health.accepting || stop_requested)
+			return finish(work, critical_submit_result::unavailable);
+		work.fresh = command.operation_id.bytes.size();
+		work.extra = sizeof(std::string);
+		if (work.fresh == SIZE_MAX ||
+		    !room_storage_add(work.extra, work.fresh > 15 ? work.fresh + 1 : 0) ||
+		    !admit(work, work.extra))
+			return rollback(work);
+		work.identity = operation_key(command.operation_id);
+		work.completed = completed_cache.find(work.identity);
+		if (work.completed != completed_cache.end())
+		{
+			if (!work.supplied_time)
