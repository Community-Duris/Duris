+bool economic_fresh_bank_runtime_budget_owner::reserve(size_t desired, void *opaque) noexcept
+{
+	// Reject a foreign/stale context before dereferencing it. The callback is
+	// reachable only through the eventual actual private Currency driver.
+	auto *owner = static_cast<economic_fresh_bank_runtime_budget_owner *>(opaque);
+	if (!owner || owner != active_)
+		return false;
+	size_t bytes = 0;
+	if (!owner->other_storage_bytes(&bytes) || bytes > PLAYER_SAVE_PIPELINE_MAX_BYTES ||
+	    owner->retained_source_ > PLAYER_SAVE_PIPELINE_MAX_BYTES - bytes)
+		return false;
+	bytes += owner->retained_source_;
+	// desired contains actual caller/child/workspace and Currency/Authority/C
+	// terms owned by the joined Currency scope. OTHER never adds those twice.
+	return desired <= PLAYER_SAVE_PIPELINE_MAX_BYTES - bytes;
