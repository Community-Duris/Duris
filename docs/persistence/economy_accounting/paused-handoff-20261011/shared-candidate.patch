+economic_accounting_error currency_transaction_fresh_budget_scope_owner::prepare_bounded(
+	P_char character, const critical_operation_id &operation_id,
+	const currency_vector &wallet_delta, const currency_vector &bank_delta,
+	currency_reason_type reason, int64_t reason_id, critical_source_site source_site,
+	critical_deadline_class deadline_class, currency_completion_fn completion,
+	const void *context, size_t context_size, critical_command *output,
+	critical_entity_key *account_key_output, reserve_fn reserve, void *reserve_context,
+	size_t outer_live) noexcept
+{
+	using error = economic_accounting_error;
+	(void)completion; // Retained by the real parent; no notification occurs here.
+	if (!output || !account_key_output || !reserve || !nevent_is_game_thread() ||
+	    active_workspace_ || !character || IS_NPC(character) || !character->only.pc ||
+	    GET_PID(character) <= 0 || context_size > CURRENCY_PENDING_CONTEXT_MAX_BYTES ||
+	    (context_size && !context) || pending.size() >= CURRENCY_PENDING_MAX ||
+	    critical_operation_id_is_zero(operation_id))
+		return error::invalid_identity;
+	const char *account_name = get_account_name_safe(character);
+	size_t name_length = 0;
+	if (!account_name)
+		return error::invalid_identity;
+	while (name_length <= CURRENCY_ACCOUNT_NAME_MAX_BYTES && account_name[name_length])
+		++name_length;
+	if (name_length > CURRENCY_ACCOUNT_NAME_MAX_BYTES ||
+	    (name_length == 7 && !memcmp(account_name, "Unknown", 7)))
+		return error::invalid_identity;
+	size_t own_source = 0;
+	if (!retained_source_frame_bytes(&own_source))
+		return error::capacity;
+	try
+	{
+		currency_command_payload payload{};
+		critical_command candidate{};
+		critical_entity_key account_key{};
+		workspace scope(reserve, reserve_context, outer_live, own_source, &candidate);
+		if (!scope.installed)
+			return error::unauthorized;
+		payload.pid = static_cast<uint32_t>(GET_PID(character));
+		payload.racewar = static_cast<uint8_t>(GET_RACEWAR(character));
+		payload.reason = reason;
+		payload.reason_id = reason_id;
+		payload.wallet_delta = wallet_delta;
+		payload.bank_delta = bank_delta;
+		memcpy(payload.account_name.data(), account_name, name_length);
+		const bool rebasable = currency_command_is_rebasable_reward(payload);
+		const uint64_t wallet_revision = rebasable ? UINT64_MAX :
+							     character->only.pc->wallet_revision;
+		const uint64_t bank_revision = rebasable ? UINT64_MAX :
+							   character->only.pc->bank_revision;
+		size_t outer = 0;
+		if (!scope.preentry(3 * currency_account_key_source_query_frame_bytes(),
+				    currency_account_key_source_frame_bytes,
+				    currency_account_key_initial_inline_bytes,
+				    currency_account_key_source_supplement_frame_bytes, &outer))
+			return error::capacity;
+		auto status = currency_account_key_bounded_status(
+			account_name, payload.racewar, &account_key, scoped_reserve, &scope, outer);
+		if (status != currency_command_bounded_result::ok)
+			return status == currency_command_bounded_result::capacity ?
+				       error::capacity :
+				       error::invalid_identity;
+		if (!scope.preentry(3 * currency_command_build_source_query_frame_bytes(),
+				    currency_command_build_source_frame_bytes,
+				    currency_command_build_initial_inline_bytes,
+				    currency_command_build_source_supplement_frame_bytes, &outer))
+			return error::capacity;
+		status = currency_command_build_bounded_status(&candidate, operation_id, payload,
+							       wallet_revision, bank_revision,
+							       source_site, deadline_class,
+							       scoped_reserve, &scope, outer);
+		if (status != currency_command_bounded_result::ok)
+			return status == currency_command_bounded_result::capacity ?
+				       error::capacity :
+				       error::invalid_identity;
+		if (!scope.preentry(
+			    2 * economic_gameplay_authority::
+						    prepare_bank_currency_source_query_frame_bytes() +
+				    economic_gameplay_authority::
+					    prepare_bank_currency_initial_query_frame_bytes(),
+			    economic_gameplay_authority::prepare_bank_currency_source_frame_bytes,
+			    economic_gameplay_authority::prepare_bank_currency_initial_inline_bytes,
+			    economic_gameplay_authority::
+				    prepare_bank_currency_source_supplement_frame_bytes,
+			    &outer))
+			return error::capacity;
+		const auto prepared = economic_gameplay_authority::prepare_bank_currency_bounded(
+			&candidate, selected_reserve, &scope, outer);
+		if (prepared != error::ok)
+			return prepared;
+		if (!scope.prefix(&outer) || !scoped_reserve(outer, &scope))
+			return error::capacity;
+		static_assert(std::is_nothrow_move_assignable_v<critical_command>);
+		*output = std::move(candidate);
+		*account_key_output = account_key;
+		return error::ok;
+	}
+	catch (const std::bad_alloc &)
+	{
+		return error::capacity;
+	}
+}
