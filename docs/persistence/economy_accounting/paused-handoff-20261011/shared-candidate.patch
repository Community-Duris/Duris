+bool currency_transaction_fresh_budget_scope_owner::fence_probe(workspace &scope,
+								const critical_entity_key &key,
+								critical_operation_id *operation,
+								bool *fenced) noexcept
+{
+	if (!fenced || scope.lender)
+		return false;
+	size_t outer = 0, request = 0, source = 0, initial = 0;
+	constexpr size_t query =
+		critical_fresh_bank_submission_owner::fence_probe_source_query_frame_bytes() +
+		critical_fresh_bank_submission_owner::fence_probe_initial_query_frame_bytes();
+	if (!scope.prefix(&outer))
+		return false;
+	request = outer;
+	if (!currency_replay_add(request, query) || !scoped_reserve(request, &scope) ||
+	    !critical_fresh_bank_submission_owner::fence_probe_source_frame_bytes(&source) ||
+	    !critical_fresh_bank_submission_owner::fence_probe_initial_inline_bytes(&initial))
+		return false;
+	request = outer;
+	if (!currency_replay_add(request, source) || !currency_replay_add(request, initial) ||
+	    !scoped_reserve(request, &scope))
+		return false;
+	try
+	{
+		// Actual original lock/lookup observer, before any held submit loan.
+		*fenced = critical_command_coordinator_is_fenced(key, operation);
+		return true;
+	}
+	catch (...)
+	{
+		return false;
+	}
+}
