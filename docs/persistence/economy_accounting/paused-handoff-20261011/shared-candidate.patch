+	if (!output || !installed_ || active_ != this || !nevent_is_game_thread() ||
+	    !save_.pipeline_locked() || !collector_.locked() || !cache_.locked())
+		return false;
+	size_t bytes = sizeof(*this) + sizeof(active_), current = 0;
+	const auto add = [&bytes](size_t amount) noexcept
+	{
+		if (amount > SIZE_MAX - bytes)
+			return false;
+		bytes += amount;
+		return true;
+	};
+	// save.current owns the actual nested lock scope inline; sizeof(*this)
+	// already includes that subobject. Subtract only that authentic overlap.
+	if (!save_.current_storage_bytes(&current) || current < sizeof(save_) ||
+	    !add(current - sizeof(save_)))
+		return false;
+	// These three owners share the original ordinary -> native -> Quest
+	// command-allocation priority in one genuine game-thread cut.
+	if (!item_movement_transaction_replay_current_storage_bytes(&current) || !add(current) ||
+	    !item_movement_fresh_bank_current_owner::current_storage_bytes(&current) ||
+	    !add(current) || !item_native_quest_retained_storage_bytes(&current) || !add(current) ||
+	    !quest_native_retained_storage_bytes(&current) || !add(current))
+		return false;
