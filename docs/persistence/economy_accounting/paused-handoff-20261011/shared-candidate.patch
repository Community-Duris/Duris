+	{
+		size_t source = 0, entry = 0, extra = 0;
+		if (!admit(query) || !full(&source) || !initial(&entry) ||
+		    (supplement && !supplement(&extra)) || !bank_prepare_add(source, entry) ||
+		    !admit(source) || !current_bytes(&child_outer) ||
+		    !bank_prepare_add(child_outer, extra))
+		{
+			denied = true;
+			return false;
+		}
+		child_supplement = extra;
+		return true;
+	}
+};
+template <class T> struct bank_prepare_watch
+{
+	const T *&slot;
+	explicit bank_prepare_watch(const T *&target, const T &value) noexcept
+		: slot(target)
+	{
+		slot = &value;
+	}
+	~bank_prepare_watch() { slot = nullptr; }
+};
+bool bank_prepare_locator(std::string_view input, bank_prepare_workspace &work)
+{
+	if (input.empty() || input.size() > CURRENCY_ACCOUNT_NAME_MAX_BYTES)
+		return false;
+	if (!work.admit(sizeof(std::string)))
+		return false;
+	std::string name;
+	bank_prepare_watch<std::string> watch(work.locator_name, name);
+	// Original empty-string reserve uses _M_create(capacity,old local-capacity).
+	// Genuine doubling applies only when requested is between 15 and30.
+	const size_t requested = input.size() > 15 ? (input.size() < 30 ? 31 : input.size() + 1) :
+						     0;
+	if (!work.admit(requested))
+		return false;
+	name.reserve(input.size());
+	for (unsigned char character : input)
+	{
+		if (character >= 'A' && character <= 'Z')
+			character += 'a' - 'A';
+		if (!((character >= 'a' && character <= 'z') ||
+		      (character >= '0' && character <= '9') || character == '_' ||
+		      character == '-'))
+			return false;
+		// reserve(input.size()) establishes sufficient capacity before all
+		// original push_back calls; no unadmitted growth is possible here.
+		name.push_back(static_cast<char>(character));
+	}
+	work.canonical = std::move(name);
+	return true;
+}
+bool bank_prepare_supported(const critical_command &candidate, bank_prepare_workspace &work)
+{
+	size_t request = 0;
+	if (!critical_command_fresh_copy_request_bytes(candidate, &request) ||
+	    !bank_prepare_add(request, sizeof(critical_command)) || !work.admit(request))
+		return false;
+	auto projection = candidate;
+	bank_prepare_watch<critical_command> watch(work.projection, projection);
+	if (!projection.accepted_at_usec)
+		projection.accepted_at_usec = 1;
+	constexpr size_t query =
+		2 * economic_bank_command_admission_source_query_frame_bytes() + sizeof(size_t);
+	if (!work.child(economic_bank_command_admission_source_frame_bytes,
+			economic_bank_command_admission_initial_inline_bytes, nullptr, query))
+		return false;
+	return economic_bank_command_admission_supported_bounded(
+		projection, bank_prepare_workspace::forward, &work, work.child_outer);
+}
