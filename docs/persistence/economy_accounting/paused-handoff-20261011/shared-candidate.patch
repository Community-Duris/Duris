+		// census. Inputs and old output stay parent-owned; new child candidates
+		// stay child-owned until its original final strong-output transfer.
+		// The child outer includes its genuine retained Source supplement.
+		// Replace only the parent census, retaining that supplement once.
+		size_t extra = requested - work.child_outer;
+		if (!bank_prepare_add(extra, work.child_supplement))
