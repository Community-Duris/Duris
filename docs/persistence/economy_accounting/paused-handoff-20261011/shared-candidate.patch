+								 bool *busy) noexcept
+{
+	if (!busy || !account)
+		return false;
+	for (const auto &[key, entry] : pending)
+	{
+		(void)key;
+		if (entry.coin && entry.coin_wallets_published && !entry.publication_required)
+			continue; // Same original pending_affects_character early return.
+		if (entry.coin)
+		{
+			for (const auto *endpoint :
+			     { &entry.coin->source, &entry.coin->destination })
+			{
+				if (endpoint->change.type != critical_command_type::account_bank)
+					continue;
+				size_t outer = 0;
+				if (!work.budget.preentry(
+					    3 * currency_command_decode_payload_source_query_frame_bytes(),
+					    currency_command_decode_payload_source_frame_bytes,
+					    currency_command_decode_payload_initial_inline_bytes,
+					    currency_command_decode_payload_source_supplement_frame_bytes,
+					    &outer))
+					return false;
+				const auto decoded = currency_command_decode_payload_bounded_status(
+					endpoint->change, &work.scratch, scoped_reserve,
+					&work.budget, outer);
+				if (decoded == currency_command_bounded_result::capacity)
+					return false;
+				// Original invalid endpoint decoding contributes no match.
+				if (decoded == currency_command_bounded_result::ok &&
+				    (work.scratch.pid == pid ||
+				     (work.scratch.racewar == racewar &&
+				      !strcasecmp(work.scratch.account_name.data(), account))))
+				{
+					*busy = true;
+					return true;
+				}
+			}
+		}
+		if (entry.pid == pid ||
+		    (entry.racewar == racewar && !strcasecmp(entry.account_name.data(), account)))
+		{
+			*busy = true;
+			return true;
+		}
+	}
+	*busy = false;
+	return true;
+}
