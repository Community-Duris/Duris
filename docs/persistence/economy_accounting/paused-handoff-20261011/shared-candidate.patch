+	    !collector_.current_storage_bytes(&current) || !add(current) ||
+	    !collector_service_replay_current_storage_bytes(&current) || !add(current) ||
+	    !auction_native_publication_current_storage_bytes(&current) || !add(current) ||
+	    !spell_component_retirement_current_storage_bytes(&current) || !add(current) ||
+	    !player_save_execution_guard::current_storage_bytes(&current) || !add(current))
+		return false;
