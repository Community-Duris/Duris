+economic_accounting_error economic_gameplay_authority::prepare_bank_currency_bounded(
+	critical_command *command, bool (*reserve)(size_t, const void *, void *) noexcept,
+	void *context, size_t outer_live) noexcept
+{
+	using error = economic_accounting_error;
+	if (!command)
+		return error::invalid_identity;
+	if (command->type != critical_command_type::account_bank)
+		return error::unauthorized;
+	if (!reserve)
+		return error::capacity;
+#if defined(_GLIBCXX_RELEASE) && _GLIBCXX_RELEASE == 13 && defined(_GLIBCXX_USE_CXX11_ABI) &&     \
+	_GLIBCXX_USE_CXX11_ABI && __cplusplus == 202002L && !defined(_GLIBCXX_DEBUG) &&           \
+	!defined(_GLIBCXX_ASSERTIONS) && !defined(_GLIBCXX_PARALLEL) && defined(__linux__) &&     \
+	defined(__x86_64__) && !defined(__SANITIZE_ADDRESS__) && !defined(__SANITIZE_THREAD__) && \
+	(!defined(_GLIBCXX_SANITIZE_VECTOR) || _GLIBCXX_SANITIZE_VECTOR == 0) &&                  \
+	defined(_GLIBCXX_HAS_GTHREADS) && defined(_GLIBCXX_ATOMIC_BUILTINS) &&                    \
+	!defined(_GLIBCXX_TSAN) && !defined(_GLIBCXX_CONCEPT_CHECKS) && defined(__GLIBC__) &&     \
+	__has_include(<sys/single_threaded.h>)
+	size_t source = 0, initial = 0, own = 0, total = outer_live;
+	constexpr size_t query = prepare_bank_currency_source_query_frame_bytes() +
+				 prepare_bank_currency_initial_query_frame_bytes() +
+				 bank_prepare_own_query;
+	if (!bank_prepare_add(total, bank_prepare_entry_query_source) ||
+	    !bank_prepare_add(total, query) || !reserve(total, nullptr, context) ||
+	    !prepare_bank_currency_source_frame_bytes(&source) ||
+	    !prepare_bank_currency_initial_inline_bytes(&initial) ||
+	    !bank_prepare_own_header_source(&own))
+		return error::capacity;
+	total = outer_live;
+	if (!bank_prepare_add(total, source) || !bank_prepare_add(total, initial) ||
+	    !reserve(total, nullptr, context))
+		return error::capacity;
+	try
+	{
+		bank_prepare_workspace work{ {},      {},      {},	{},	 nullptr,
+					     nullptr, nullptr, reserve, context, outer_live,
+					     own,     0,       0,	false };
+		try
+		{
+			const auto outcome = [&]() -> error
+			{
+				work.selected = current.load(std::memory_order_acquire);
+				// Immutable snapshot identity remains genuine throughout this invocation.
+				// Original install/replacement is permitted; the host counts a distinct
+				// current snapshot separately, never treating this as lifecycle proof.
+				if (!work.admit())
+					return error::capacity;
+				if (work.selected && sql_recovery_scope(*work.selected) &&
+				    (command->schema_version !=
+					     CRITICAL_COMMAND_ACCOUNTING_SCHEMA_VERSION ||
+				     !command->accepted_at_usec))
+					return error::unauthorized;
+				if (work.selected && sql_wallet_root_scope(*work.selected))
+					return error::unauthorized;
+				if (command->schema_version ==
+				    CRITICAL_COMMAND_ACCOUNTING_SCHEMA_VERSION)
+				{
+					const bool supported =
+						bank_prepare_supported(*command, work);
+					return work.denied ? error::capacity :
+					       supported   ? error::ok :
+							     error::unauthorized;
+				}
+				if (!critical_command_legacy_execution_supported(*command))
+					return error::corrupt_evidence;
+				if (!work.selected)
+					return error::ok;
+				if (command->accepted_at_usec || command->publication_required)
+					return error::unauthorized;
+				constexpr size_t decode_query =
+					3 * currency_command_decode_payload_source_query_frame_bytes() +
+					sizeof(size_t);
+				if (!work.child(
+					    currency_command_decode_payload_source_frame_bytes,
+					    currency_command_decode_payload_initial_inline_bytes,
+					    currency_command_decode_payload_source_supplement_frame_bytes,
+					    decode_query))
+					return error::capacity;
+				const auto decoded = currency_command_decode_payload_bounded_status(
+					*command, &work.payload, bank_prepare_workspace::forward,
+					&work, work.child_outer);
+				if (decoded != currency_command_bounded_result::ok)
+					return work.denied || decoded ==
+								       currency_command_bounded_result::
+									       capacity ?
+						       error::capacity :
+						       error::corrupt_evidence;
+				const bool quest_wallet_reward =
+					work.payload.reason ==
+						currency_reason_type::wallet_reward &&
+					work.payload.reason_id > 0 &&
+					command->source_site == critical_source_site::recovery &&
+					command->deadline_class ==
+						critical_deadline_class::recovery;
+				if (work.payload.reason != currency_reason_type::atm_deposit &&
+				    work.payload.reason != currency_reason_type::atm_withdraw &&
+				    work.payload.reason !=
+					    currency_reason_type::chaos_starter_reward &&
+				    !quest_wallet_reward)
+					return error::incomplete_coverage;
+				if (!bank_prepare_locator(work.payload.account_name.data(), work))
+					return work.denied ? error::capacity :
+							     error::invalid_identity;
+				const auto wallet = work.selected->wallets.find(work.payload.pid);
+				// Preserve the original temporary pair's canonical string copy request.
+				const size_t key_request =
+					work.canonical.size() > 15 ? work.canonical.size() + 1 : 0;
+				if (!work.admit(sizeof(std::pair<std::string, uint8_t>) +
+						key_request))
+					return error::capacity;
+				const auto bank = work.selected->banks.find(
+					{ work.canonical, work.payload.racewar });
+				if (wallet == work.selected->wallets.end() ||
+				    bank == work.selected->banks.end())
+					return error::incomplete_coverage;
+				size_t copy = 0;
+				if (!critical_command_fresh_copy_request_bytes(*command, &copy) ||
+				    !bank_prepare_add(copy, sizeof(critical_command)) ||
+				    !work.admit(copy))
+					return error::capacity;
+				critical_command frozen = *command;
+				bank_prepare_watch<critical_command> frozen_watch(work.frozen,
+										  frozen);
+				constexpr size_t intent_query =
+					2 * economic_currency_intent_source_query_frame_bytes() +
+					sizeof(size_t);
+				if (!work.child(economic_currency_intent_source_frame_bytes,
+						economic_currency_intent_initial_inline_bytes,
+						nullptr, intent_query))
+					return error::capacity;
+				error result;
+				if (work.payload.reason ==
+				    currency_reason_type::chaos_starter_reward)
+					result = economic_chaos_starter_bank_intent_bounded(
+						frozen, work.selected->epoch, wallet->second,
+						bank->second, &work.intent,
+						bank_prepare_workspace::forward, &work,
+						work.child_outer);
+				else if (quest_wallet_reward)
+					result = economic_quest_wallet_reward_intent_bounded(
+						frozen, work.selected->epoch, wallet->second,
+						bank->second, &work.intent,
+						bank_prepare_workspace::forward, &work,
+						work.child_outer);
+				else
+					result = economic_bank_transfer_intent_bounded(
+						frozen, work.selected->epoch, wallet->second,
+						bank->second, &work.intent,
+						bank_prepare_workspace::forward, &work,
+						work.child_outer);
+				if (result != error::ok)
+					return work.denied ? error::capacity : result;
+				frozen.schema_version = CRITICAL_COMMAND_ACCOUNTING_SCHEMA_VERSION;
+				frozen.accounting_intent = std::move(work.intent);
+				if (!bank_prepare_supported(frozen, work))
+					return work.denied ? error::capacity :
+							     error::corrupt_evidence;
+				if (!work.admit())
+					return error::capacity;
+				*command = std::move(frozen);
+				return error::
+					ok; // no fallible callback after original successful transfer
+			}();
+			return work.denied ? error::capacity : outcome;
+		}
+		catch (const std::bad_alloc &)
+		{
+			return error::capacity;
+		}
+	}
+	catch (const std::bad_alloc &)
+	{
+		return error::capacity;
+	}
+#else
+	(void)context;
+	(void)outer_live;
+	return error::capacity;
+#endif
+}
