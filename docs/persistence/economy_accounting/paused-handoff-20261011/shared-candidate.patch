+bool economic_fresh_bank_runtime_budget_owner::submit_identified_bounded(
+	P_char character, const critical_operation_id &operation_id,
+	const currency_vector &wallet_delta, const currency_vector &bank_delta,
+	currency_reason_type reason, int64_t reason_id, critical_source_site source_site,
+	critical_deadline_class deadline_class, currency_completion_fn completion,
+	const void *context, size_t context_size, size_t actual_caller_live,
+	bool *publish_after_release, std::string *publication_key) noexcept
+{
+	// This test precedes ALL member construction: attempting to acquire the
+	// same nonrecursive save locks and checking active_ afterward is too late.
+	if (!publish_after_release || !publication_key || !nevent_is_game_thread() || active_ ||
+	    actual_caller_live > PLAYER_SAVE_PIPELINE_MAX_BYTES ||
+	    (reason != currency_reason_type::atm_deposit &&
+	     reason != currency_reason_type::atm_withdraw) ||
+	    reason_id != 0 || source_site != critical_source_site::command ||
+	    deadline_class != critical_deadline_class::interactive || !character ||
+	    IS_NPC(character) || !character->only.pc || GET_PID(character) <= 0 ||
+	    context_size > CURRENCY_PENDING_CONTEXT_MAX_BYTES || (context_size && !context) ||
+	    critical_operation_id_is_zero(operation_id))
+		return false;
+	// Pure prospective query storage is part of bootstrap, never a permit.
+	// Source metadata closure must cover these exact accessor/getter calls.
+	// No current snapshot, cached total or prior prepared-startup cut is used.
+	size_t request = actual_caller_live;
+	const size_t query = source_query_frame_bytes();
+	if (query > PLAYER_SAVE_PIPELINE_MAX_BYTES - request)
+		return false;
+	request += query;
+	size_t root_source = 0, root_initial = 0;
+	if (!source_frame_bytes(&root_source) || !initial_inline_bytes(&root_initial) ||
+	    root_source > PLAYER_SAVE_PIPELINE_MAX_BYTES - request)
+		return false;
+	request += root_source;
+	if (root_initial > PLAYER_SAVE_PIPELINE_MAX_BYTES - request)
+		return false;
+	request += root_initial;
+	// Genuine member INITIAL is admitted now. It subsequently lives in Root
+	// CURRENT, so reserve never adds it to desired or retains this bootstrap
+	// request as though it were another physical owner.
+	bool kept = false, publish = false;
+	try
+	{
+		{
+			economic_fresh_bank_runtime_budget_owner owner(root_source);
+			request = actual_caller_live;
+			if (!reserve(request, &owner))
+				return false;
+			// Authenticate the full held CURRENT cut before entering even the
+			// child's pure metadata graph, and again before allocating work.
+			const size_t child_query = currency_transaction_fresh_budget_scope_owner::
+							   joined_source_query_frame_bytes() +
+						   currency_transaction_fresh_budget_scope_owner::
+							   joined_initial_query_frame_bytes();
+			if (child_query > PLAYER_SAVE_PIPELINE_MAX_BYTES - request)
+				return false;
+			request += child_query;
+			if (!reserve(request, &owner))
+				return false;
+			size_t child_source = 0, child_initial = 0;
+			if (!currency_transaction_fresh_budget_scope_owner::joined_source_frame_bytes(
+				    &child_source) ||
+			    !currency_transaction_fresh_budget_scope_owner::
+				    joined_initial_inline_bytes(&child_initial))
+				return false;
+			request = actual_caller_live;
+			if (child_source > PLAYER_SAVE_PIPELINE_MAX_BYTES - request)
+				return false;
+			request += child_source;
+			if (child_initial > PLAYER_SAVE_PIPELINE_MAX_BYTES - request)
+				return false;
+			request += child_initial;
+			if (!reserve(request, &owner))
+				return false;
+			// Currency owns its genuine workspace/CURRENT/Source descendants.
+			// The real callback adds only this held OTHER and Root Source.
+			kept = currency_transaction_fresh_budget_scope_owner::
+				submit_identified_bounded(character, operation_id, wallet_delta,
+							  bank_delta, reason, reason_id,
+							  source_site, deadline_class, completion,
+							  context, context_size, reserve, &owner,
+							  actual_caller_live, &publish,
+							  publication_key);
+		}
+		// The actual Currency/Coordinator/Authority loans have ended, then
+		// G is ended and Redis/Collector/save destructors have released locks.
+		// This passive result carries no callback; original caller publishes.
+	}
+	catch (...)
+	{
+		// Any failed member construction unwinds actual constructed members.
+		// This is a runtime refusal, not native exception-storage qualification.
+		return false;
+	}
+	if (!kept)
+		return false;
+	*publish_after_release = publish;
+	return true;
