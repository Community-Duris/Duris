+// Unselected joined ATM runtime. Its own Source/INITIAL definitions are pending;
+// no preparation profile is substituted for the new pending/table/observer graph.
+struct currency_transaction_fresh_budget_scope_owner::joined_workspace
+{
+	currency_command_payload payload{}, decoded{}, scratch{};
+	critical_command command{};
+	critical_entity_key account_key{}, player_key{};
+	critical_operation_id fence{};
+	pending_currency entry{};
+	std::string key;
+	currency_pending_table::iterator existing;
+	critical_submit_result submitted = critical_submit_result::invalid;
+	bool inserted = false, kept = false, publish_attached = false;
+	workspace budget;
+	joined_workspace(reserve_fn callback, void *actual, size_t outer, size_t source) noexcept
+		: budget(callback, actual, outer, source, &command)
+	{
+		// These exact subobjects are already owned by the preparation prefix.
+		// All other enclosing fields/padding remain actual joined inline bytes.
+		constexpr size_t preparation =
+			sizeof(workspace) + sizeof(payload) + sizeof(command) + sizeof(account_key);
+		static_assert(sizeof(joined_workspace) >= preparation);
+		budget.joined_inline = sizeof(joined_workspace) - preparation;
+		budget.joined_key = &key;
+	}
+	~joined_workspace() noexcept
+	{
+		// No callback during rollback. Source/cleanup was priced before insertion.
+		// The real key and budget/active scope are still alive at this point.
+		if (inserted && !kept)
+			pending.erase(key);
+	}
+};
