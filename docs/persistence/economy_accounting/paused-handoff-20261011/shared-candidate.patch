+	active_workspace_->lender = actual_lender;
+	active_workspace_->coordinator_bytes = current_coordinator_bytes;
+	return true;
+}
+bool currency_transaction_fresh_budget_scope_owner::refresh_borrow(
+	const void *actual_lender, reserve_fn actual_reserve, void *actual_guard,
+	size_t current_coordinator_bytes) noexcept
+{
+	if (!actual_lender || !borrowed_for(actual_guard, actual_reserve) ||
+	    active_workspace_->lender != actual_lender)
+		return false;
+	active_workspace_->coordinator_bytes = current_coordinator_bytes;
+	return true;
+}
+bool currency_transaction_fresh_budget_scope_owner::end_borrow(const void *actual_lender) noexcept
+{
+	if (!nevent_is_game_thread() || !active_workspace_ || !actual_lender ||
+	    active_workspace_->lender != actual_lender)
+		return false;
+	active_workspace_->lender = nullptr;
+	active_workspace_->coordinator_bytes = 0;
+	return true;
+}
+bool currency_transaction_fresh_budget_scope_owner::exclusive_prefix(void *actual_guard,
+								     reserve_fn actual_reserve,
+								     size_t full,
+								     size_t *exclusive) noexcept
+{
+	if (!exclusive || !borrowed_for(actual_guard, actual_reserve) ||
+	    full < active_workspace_->coordinator_bytes)
+		return false;
+	*exclusive = full - active_workspace_->coordinator_bytes;
+	return true;
