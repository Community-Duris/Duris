+			work.existing = pending.find(work.key);
+			if (work.existing == pending.end())
+			{
+				bool busy = false;
+				if (!pending_busy(work, work.payload.pid, work.payload.racewar,
+						  account, &busy) ||
+				    busy)
+					return false;
