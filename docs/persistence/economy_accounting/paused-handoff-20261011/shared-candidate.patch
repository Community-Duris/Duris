+		       bank_prepare_shared_assignment_source + authority_observation_load_source +
+		       bank_prepare_string_reserve + bank_prepare_string_push +
+		       bank_prepare_string_move +
+		       bank_prepare_map_find_source<bank_prepare_wallet_map> +
+		       bank_prepare_map_find_source<bank_prepare_bank_map> +
