# ==============================================================================
# DurisMUD - Repository Ignore Rules
# ==============================================================================
# Generated artifacts, runtime data, credentials, and machine-local state stay
# outside version control. Rules are grouped by purpose and sorted by path.
# Negation rules remain directly below the parent rule they override.

# ------------------------------------------------------------------------------
# Build outputs and generated toolchain artifacts
# ------------------------------------------------------------------------------
/areas/de/src/cscope.out
/bin/*
!/bin/.gitignore
/build
/gmon.out
__pycache__/
cscope.out
durismud-launcher
migrate_pfiles

# ------------------------------------------------------------------------------
# Environment, credentials, and host-specific files
# ------------------------------------------------------------------------------
.bash_history
.c*
.env
/Duris.xcodeproj
/certs/*.crt
/certs/*.key
duris.crt
duris.key
etc/group
etc/passwd
etc/resolv.conf

# ------------------------------------------------------------------------------
# Account, player, ship, and backup runtime data
# ------------------------------------------------------------------------------
Accounts/*/*
!Accounts/*/.gitkeep
Accounts/email.db
/Accounts/mail
Accounts.old.*
arih/
backup/
/Players/**
!/Players/wipers/
!/Players/wipers/wipe_it_all
Players.old.*
Ships/ship_index

# ------------------------------------------------------------------------------
# Generated game data and mutable library state
# ------------------------------------------------------------------------------
lib/ban_sites
lib/etc/help
lib/etc/vote.miniwipe
lib/etc/vote.undead
lib/information/hardcore_hall_of_fame
lib/information/hardcore_hall_of_fameprod
lib/information/leaderboard
lib/information/leaderboardprod
lib/information/leaderboardprod
lib/relic_highscore

# ------------------------------------------------------------------------------
# Logs, journals, exports, and recovery state
# ------------------------------------------------------------------------------
/logs/duris-console.log
/logs/latency_trace.log
logs/log/*
logs/shutdown_info.txt
logs/valgrind/
/runtime/personal-data-exports/
/runtime/player-journal/

# ------------------------------------------------------------------------------
# Temporary files, editor leftovers, and local analysis artifacts
# ------------------------------------------------------------------------------
*.backup
*~
.hermes/
/nohup.out
/temp_letterfile
/tmp/
/tmp/query-plan-gate/
/tmp_*.py
/tmp_*.txt

# ------------------------------------------------------------------------------
# Local-only Docker and database test fixtures
# ------------------------------------------------------------------------------
/Dockerfile
tests/db_write/*.c
tests/db_write/*.h
tests/db_write/Dockerfile.*
tests/db_write/Makefile*
tests/db_write/schema.sql

# Database dumps written by scripts/backup_pfiles.sh (player/account data).
db/Backup/
