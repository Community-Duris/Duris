@QUEST_BUILDER_METHOD@

namespace
{
[[maybe_unused]] bool forbidden_observer(size_t *) noexcept { assert(false); return false; }
[[maybe_unused]] bool forbidden_reserve(size_t, void *) noexcept { assert(false); return false; }

struct recorded_admission
{
    size_t ordinal=0, refuse_at=0;
    std::array<size_t,128> requests{};
};

[[maybe_unused]] bool real_recording_reserve(size_t request, void *opaque) noexcept
{
    auto &record=*static_cast<recorded_admission *>(opaque);
    ++record.ordinal;
    // Test-controlled persistent input forces the real aggregate cap to refuse.
    // The callback always invokes the genuine accepted temporary seam.
    if (record.ordinal==record.refuse_at)
        native_quest_birth_retained_bytes=PLAYER_SAVE_PIPELINE_MAX_BYTES;
    const size_t driver=native_quest_gameplay_retained_bytes;
    const size_t birth=native_quest_birth_retained_bytes;
    const bool accepted=quest_native_completion_owner::reserve_cost_projection(request,nullptr);
    assert(native_quest_gameplay_retained_bytes==driver);
    assert(native_quest_birth_retained_bytes==birth);
    assert(record.ordinal<=record.requests.size());
    record.requests[record.ordinal-1]=request;
    return accepted;
}

void clear_inputs()
{
    native_quest_acceptances.clear();
    native_quest_gameplay_retained_bytes=0;
    native_quest_birth_retained_bytes=0;
    native_quest_flat_global_observer=nullptr;
    native_quest_flat_global_scope=nullptr;
    native_quest_flat_literal_pool_owned=false;
    native_quest_coordinator_observer=nullptr;
    native_quest_coordinator_reserve=nullptr;
    native_quest_coordinator_lender=nullptr;
    native_quest_coordinator_guard=nullptr;
    native_quest_coordinator_borrowed_bytes=0;
}
}

namespace
{
// Constructed passive snapshot values, not custody, gameplay or persistence proof.
struct selected_inputs
{
    std::vector<player_item_snapshot> native_items, selected;
    std::vector<native_quest_cost_requirement> attempted_costs;
    std::vector<uint64_t> ordered_roots, roots;
    std::unordered_set<uint64_t> consumed;
    std::vector<int32_t> indexes;
    std::vector<uint8_t> selected_bytes;
    size_t prior_output_reserve=256;

    selected_inputs()
    {
        selected.resize(3);
        for(size_t index=0;index<selected.size();++index)
        {
            selected[index].parent_index=index ? static_cast<int32_t>(index-1) : PLAYER_SNAPSHOT_NO_PARENT;
            selected[index].object_uid=index+101;
            selected[index].name=std::string(48,'n');
            selected[index].string_mask=1;
        }
        native_items=selected;
        attempted_costs.push_back({0,1}); ordered_roots.push_back(101);
        roots.push_back(101); consumed.insert(101); indexes.push_back(0);
    }

    quest_selected_encode_live live(size_t extra=0) const
    {
        return {extra,native_items,attempted_costs,ordered_roots,consumed,selected,
                indexes,roots,selected_bytes};
    }

    player_snapshot_codec_result invoke(size_t driver=0, size_t birth=0, size_t extra=0)
    {
        // Identical old output capacity on every boundary probe, including after success.
        std::vector<uint8_t> prior{19,23,29}; prior.reserve(prior_output_reserve); selected_bytes.swap(prior);
        const auto before=selected_bytes;
        const auto *data=selected_bytes.data(); const size_t capacity=selected_bytes.capacity();
        native_quest_gameplay_retained_bytes=driver; native_quest_birth_retained_bytes=birth;
        const auto status=quest_native_completion_owner::encode_selected_items(&selected_bytes,live(extra));
        assert(native_quest_gameplay_retained_bytes==driver && native_quest_birth_retained_bytes==birth);
        if(status!=player_snapshot_codec_result::ok)
        {
            assert(selected_bytes==before && selected_bytes.data()==data);
            assert(selected_bytes.capacity()==capacity);
        }
        return status;
    }
};

[[maybe_unused]] size_t selected_parent_frontier(selected_inputs &inputs)
{
    using result=player_snapshot_codec_result;
    constexpr size_t birth=17;
    size_t low=0,high=PLAYER_SAVE_PIPELINE_MAX_BYTES;
    assert(inputs.invoke(low,birth)==result::ok);
    assert(inputs.invoke(high,birth)==result::limit_exceeded);
    while(high-low>1)
    {
        const size_t middle=low+(high-low)/2;
        const auto status=inputs.invoke(middle,birth);
        assert(status==result::ok || status==result::limit_exceeded);
        if(status==result::ok) low=middle; else high=middle;
    }
    // Genuine parent cap boundary plus adjacent scalar refusal sweep; no callback hook.
    assert(inputs.invoke(low,birth)==result::ok);
    for(size_t delta=1;delta<=3;++delta)
        assert(inputs.invoke(low+delta,birth)==result::limit_exceeded);
    assert(inputs.invoke(low, birth+1)==result::limit_exceeded);
    assert(inputs.invoke(low+1,birth-1)==result::ok);
    return low;
}

void selected_cases()
{
    using result=player_snapshot_codec_result;
    clear_inputs(); selected_inputs inputs;
#if defined(__NO_MYSQL__) || defined(_GLIBCXX_ASSERTIONS) || defined(_GLIBCXX_PARALLEL) || defined(_GLIBCXX_DEBUG)
    assert(inputs.invoke(7,11)==result::limit_exceeded);
    assert(quest_native_completion_owner::encode_selected_items(nullptr,inputs.live())==result::limit_exceeded);
    std::cout<<"QUEST_SELECTED_LIST {\"unsupported_no_writes\":true}\n";
#else
    std::vector<uint8_t> expected;
    assert(player_item_snapshot_list_encode(inputs.selected,&expected)==result::ok);
    assert(inputs.invoke()==result::ok && inputs.selected_bytes==expected);
    assert(quest_native_completion_owner::encode_selected_items(nullptr,inputs.live())==result::invalid_value);
    inputs.selected.clear();
    assert(player_item_snapshot_list_encode(inputs.selected,&expected)==result::ok);
    assert(expected==std::vector<uint8_t>({0,0,0,0}));
    assert(inputs.invoke()==result::ok && inputs.selected_bytes==expected); // Original fee-only empty wire.

    auto invalid=[&] {
        std::vector<uint8_t> original{31,37};
        const auto status=player_item_snapshot_list_encode(inputs.selected,&original);
        assert(status!=result::ok);
        assert(original==std::vector<uint8_t>({31,37}));
        assert(inputs.invoke()==status);
    };
    inputs.selected.resize(1); inputs.selected[0].parent_index=0; invalid();
    inputs.selected.assign(PLAYER_SNAPSHOT_MAX_DEPTH+1,player_item_snapshot{});
    for(size_t index=0;index<inputs.selected.size();++index)
        inputs.selected[index].parent_index=index ? static_cast<int32_t>(index-1) : PLAYER_SNAPSHOT_NO_PARENT;
    invalid();
    inputs.selected.assign(PLAYER_SNAPSHOT_MAX_OBJECTS+1,player_item_snapshot{});
    for(auto &row:inputs.selected) row.parent_index=PLAYER_SNAPSHOT_NO_PARENT;
    invalid();
    inputs.selected.assign(1,player_item_snapshot{});
    inputs.selected[0].parent_index=PLAYER_SNAPSHOT_NO_PARENT;
    inputs.selected[0].name.assign(PLAYER_SNAPSHOT_MAX_STRING_BYTES+1,'s'); invalid();

    selected_inputs capacity_inputs;
    const size_t original_frontier=selected_parent_frontier(capacity_inputs);
    const size_t old_capacity=capacity_inputs.native_items[0].name.capacity();
    capacity_inputs.native_items[0].name.reserve(old_capacity+8192);
    const size_t increased=capacity_inputs.native_items[0].name.capacity()-old_capacity;
    const size_t nested_frontier=selected_parent_frontier(capacity_inputs);
    assert(original_frontier-nested_frontier==increased);
    const size_t old_buckets=capacity_inputs.consumed.bucket_count();
    capacity_inputs.consumed.reserve(old_buckets+1024);
    const size_t bucket_frontier=selected_parent_frontier(capacity_inputs);
    assert(nested_frontier-bucket_frontier==
           (capacity_inputs.consumed.bucket_count()-old_buckets)*sizeof(void*));
    const size_t before_nodes=capacity_inputs.consumed.size();
    capacity_inputs.consumed.insert(102); capacity_inputs.consumed.insert(103);
    const size_t node_frontier=selected_parent_frontier(capacity_inputs);
    using consumed_table=decltype(capacity_inputs.consumed);
    using consumed_node=std::__detail::_Hash_node<consumed_table::value_type,
        std::__cache_default<consumed_table::key_type,consumed_table::hasher>::value>;
    assert(bucket_frontier-node_frontier==(capacity_inputs.consumed.size()-before_nodes)*sizeof(consumed_node));
    size_t frontier=node_frontier;
    auto grow_rows=[&](auto &rows) {
        using row_type=typename std::remove_reference_t<decltype(rows)>::value_type;
        const size_t before_capacity=rows.capacity(); rows.reserve(before_capacity+32);
        const size_t next=selected_parent_frontier(capacity_inputs);
        assert(frontier-next==(rows.capacity()-before_capacity)*sizeof(row_type)); frontier=next;
    };
    grow_rows(capacity_inputs.attempted_costs); grow_rows(capacity_inputs.ordered_roots);
    grow_rows(capacity_inputs.indexes); grow_rows(capacity_inputs.roots);
    assert(capacity_inputs.invoke(PLAYER_SAVE_PIPELINE_MAX_BYTES)==result::limit_exceeded);
    const size_t previous_output_capacity=capacity_inputs.selected_bytes.capacity();
    capacity_inputs.prior_output_reserve=previous_output_capacity+4096;
    assert(capacity_inputs.invoke(PLAYER_SAVE_PIPELINE_MAX_BYTES)==result::limit_exceeded);
    const size_t output_capacity_delta=capacity_inputs.selected_bytes.capacity()-previous_output_capacity;
    const size_t output_frontier=selected_parent_frontier(capacity_inputs);
    assert(frontier-output_frontier==output_capacity_delta);
    assert(capacity_inputs.invoke(0,0,SIZE_MAX)==result::limit_exceeded);

    // Direct genuine child codec callbacks, explicitly separate from the hardcoded parent relay.
    clear_inputs(); recorded_admission child;
    std::vector<uint8_t> child_bytes{41,43}; child_bytes.reserve(256);
    assert(player_item_snapshot_list_encode_bounded(capacity_inputs.selected,&child_bytes,
        real_recording_reserve,&child,0)==result::ok);
    assert(child.ordinal>0);
    for(size_t point=1;point<=child.ordinal;++point)
    {
        clear_inputs(); child_bytes={41,43};
        const auto *old_data=child_bytes.data(); const size_t old_capacity_bytes=child_bytes.capacity();
        recorded_admission denied; denied.refuse_at=point;
        assert(player_item_snapshot_list_encode_bounded(capacity_inputs.selected,&child_bytes,
            real_recording_reserve,&denied,0)==result::limit_exceeded);
        assert(denied.ordinal==point && child_bytes==std::vector<uint8_t>({41,43}));
        assert(child_bytes.data()==old_data && child_bytes.capacity()==old_capacity_bytes);
    }
    clear_inputs();
    auto registered=[&] { assert(capacity_inputs.invoke()==result::limit_exceeded); clear_inputs(); };
    native_quest_flat_global_observer=forbidden_observer; registered();
    native_quest_flat_global_scope=&capacity_inputs; registered();
    native_quest_flat_literal_pool_owned=true; registered();
    native_quest_coordinator_observer=forbidden_observer; registered();
    native_quest_coordinator_reserve=forbidden_reserve; registered();
    native_quest_coordinator_lender=&capacity_inputs; registered();
    native_quest_coordinator_guard=&capacity_inputs; registered();
    native_quest_coordinator_borrowed_bytes=1; registered();
    bool foreign_success=true;
    std::thread foreign([&] { foreign_success=capacity_inputs.invoke()==result::ok; });
    foreign.join(); assert(!foreign_success);
    clear_inputs();
    std::cout<<"QUEST_SELECTED_LIST {\"wire_cases\":2,\"invalid_cases\":4,"
             <<"\"parent_cap_boundaries\":true,\"capacity_inputs\":true,\"registered_states\":8,"
             <<"\"child_refusal_points\":"<<child.ordinal
             <<",\"no_retained_writes\":true,\"strong_output\":true}\n";
#endif
}
}

namespace
