// Generated exact Quest descriptor/helpers/adapter follow here. This fixture TU
// includes the actual Item implementation, so its genuine private registries and
// retained scalars can be controlled without adding production test hooks.
namespace { @QUEST_DESCRIPTOR@ }
namespace { @QUEST_SELECTED_DESCRIPTOR@ }

class quest_native_completion_owner
{
public:
    static bool reserve_cost_projection(size_t, void *) noexcept;
    static bool build_original_command(critical_command *, critical_operation_id,
				       const quest_cost_prepare_live &,
				       const quest_reward_continuation &) noexcept;
    static player_snapshot_codec_result encode_selected_items(
        std::vector<uint8_t> *, const quest_selected_encode_live &) noexcept;
    static native_quest_cost_projection_result project_cost_projection(
        const quest_mobile_native_cash_reference &, native_quest_cost_projection *,
        const quest_cost_prepare_live &) noexcept;
    static bool profile(size_t *value) noexcept
    { return item_native_quest_temporary_budget_owner::source_frame_bytes(value); }
    static bool initial(size_t *value) noexcept
    { return item_native_quest_temporary_budget_owner::initial_inline_bytes(value); }
};

