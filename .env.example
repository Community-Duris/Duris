# Duris Environment Variables
# Copy this file to .env and modify as needed
# Load with: source .env (or use a wrapper script)

# Local/Dev or Production/Remote
ENVIRONMENT=local

# game domain
GAME_DOMAIN=duris.sbs

# listen address
LISTEN_ADDRESS=127.0.0.1
# Optional development plain-telnet port used by --dev/--minimal; defaults to
# 4000 and must not be the production port 7777.
DURIS_DEV_PORT=4000
# Optional independent TLS telnet port; defaults to the plain port plus one.
DURIS_TLS_PORT=
# WebSocket and HTTP health listener. Defaults to 4050 when unset.
DURIS_WEBSOCKET_PORT=4050
# Production requires this WebSocket-only listener to be loopback so a local
# TLS terminator owns the public endpoint.
DURIS_WEBSOCKET_LISTEN_ADDRESS=127.0.0.1
# Exact comma-separated browser Origin values. Required in production.
DURIS_WEBSOCKET_ALLOWED_ORIGINS=https://www.example.com
# Immediate local reverse proxy whose forwarded client address may be trusted.
DURIS_TRUSTED_PROXY_IP=127.0.0.1

# Whole-server persistence authority. Use flatfile-primary with a client-free
# build (`make -C src PERSISTENCE_BACKEND=flatfile`).
PERSISTENCE_MODE=mariadb-primary
# Required by either flat-file mode; must be an absolute owner-controlled path.
FLATFILE_STATE_DIR=/absolute/path/to/duris/runtime/flatfile-state
# Optional flatfile-primary pre-boot backup root; defaults to backups/flatfile.
FLATFILE_BACKUP_DIR=/absolute/path/to/duris/backups/flatfile

# Database Configuration (required only by database-backed modes; there are no
# credential defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWD=
DB_NAME=
# Exact comma-separated host/database pairs permitted for this process.
DB_ALLOWED_TARGETS=127.0.0.1/duris_dev
# Non-loopback databases require DB_TLS=TRUE and a CA file.
DB_TLS=FALSE
DB_SSL_CA=
# Optional local-mode Unix socket. Leave empty for loopback TCP.
DB_SOCKET=

# Absolute, server-user-owned directory for typed player save recovery records.
PLAYER_SAVE_JOURNAL_DIR=/absolute/path/to/duris/runtime/player-journal
# Absolute, server-user-owned directory for non-coalescing critical commands.
CRITICAL_COMMAND_JOURNAL_DIR=/absolute/path/to/duris/runtime/critical-command-journal

# DurisWeb GMCP Authentication Secret (must match website)
DURISWEB_SECRET=put-secret-here
# Optional old key accepted during a zero-downtime rotation window.
DURISWEB_SECRET_PREVIOUS=
# Opt in only when the backend may receive account names, client metadata, IP
# addresses, and invisible staff presence.
DURISWEB_PRIVATE_PRESENCE=FALSE

# Redis-backed caches, presence, maintenance, immutable world recovery, and donation
# notices are enabled for the local development template. Player dirty state remains
# owned by the local revisioned save pipeline and journal, never Redis membership.
REDIS=TRUE
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional absolute Unix-socket path. When set, REDIS_HOST and REDIS_PORT must be empty.
REDIS_SOCKET=
REDIS_DB=0
# Required application/environment/deployment isolation prefix.
REDIS_NAMESPACE=duris:local:default
# Local development may use this shared fallback. Production requires the distinct
# subsystem identities below; provision their ACL rules before starting the server.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_WORLD_USERNAME=
REDIS_WORLD_PASSWORD=
REDIS_PRESENCE_USERNAME=
REDIS_PRESENCE_PASSWORD=
REDIS_CACHE_USERNAME=
REDIS_CACHE_PASSWORD=
REDIS_DONATION_USERNAME=
REDIS_DONATION_PASSWORD=
REDIS_MAINTENANCE_USERNAME=
REDIS_MAINTENANCE_PASSWORD=
REDIS_TLS=FALSE
REDIS_CA_CERT=
REDIS_TLS_SERVER_NAME=
# Exact comma-separated host:port/database or unix:/socket/path/database targets authorized
# for destructive Redis maintenance.
REDIS_ALLOWED_TARGETS=127.0.0.1:6379/0
REDIS_WORLD_STATE=TRUE
REDIS_WORLD_STATE_INTERVAL=10
REDIS_WORLD_STATE_MAX_AGE=300
# Local-only placeholder. Replace it with an independent random 32-256 byte secret
# before using this configuration outside an isolated development machine.
REDIS_WORLD_STATE_SECRET=local-development-only-world-state-hmac-change-before-shared-use
# Optional old secret accepted only while rotating recovery authentication.
REDIS_WORLD_STATE_SECRET_PREVIOUS=
# Local development enables authenticated donation notices too. Replace this distinct
# placeholder before connecting any external publisher.
REDIS_DONATION_SUBSCRIBER=TRUE
REDIS_DONATION_SECRET=local-development-only-donation-hmac-change-before-shared-use

# Optional durable maintenance cursor/completion file. The default is under bin/server.
MAINTENANCE_STATE_FILE=bin/server/maintenance-scheduler.state

# Character creation: open the normally unavailable player races (the
# descend-only undead forms, plus half-elf, wood elf, kuo-toa, orog, harpy,
# illithid and storm giant) in the race selection menu. They appear in their
# own clearly labelled block and are picked by typing the race name.
# Intended for local testing; leave FALSE on a live server.
CREATION_ALL_RACES=FALSE

# Character creation: expose every defined player class, including classes
# normally reached through progression or disabled by creation policy. These
# choices appear in their own clearly labelled block in class menus.
CREATION_ALL_CLASSES=FALSE

# Chaos gameplay mode. Must be exactly TRUE or FALSE.
# TRUE enables automatic level 56 characters and the other chaos rules.
CHAOS_MUD=FALSE

# Chaos-mode starter equipment profile. `standard` grants the observed high-end
# set; `enhanceable` restricts equipment and class fundamentals to the items
# admitted by the boot-time enhance index.
CHAOS_EQ_PROFILE=standard

# Optional local Chaos integration harness commands. These require both
# ENVIRONMENT=local and an exact TRUE value; leave disabled outside tests.
CHAOS_TEST_COMMANDS=FALSE

# Optional durable Chaos new-character infinite-starting grants. These are active only
# when CHAOS_MUD=TRUE. The master switch disables all additions; each feature
# can also be disabled independently. Values must be exactly TRUE or FALSE.
CHAOS_STARTER_BONUSES=TRUE
CHAOS_STARTER_FRIGATE=TRUE
CHAOS_STARTER_EPIC_SKILLS=TRUE
CHAOS_STARTER_EPIC_POINTS=TRUE
CHAOS_STARTER_BANK_PLATINUM=TRUE
CHAOS_STARTER_MATERIALS=TRUE

# Optional local test account used by selected integration harnesses. Keep these
# blank unless the account already exists; never commit real credentials. Values
# in this file must remain valid shell assignment syntax because the launcher
# sources `.env` with Bash.
GAME_ACCOUNT_NAME=
GAME_ACCOUNT_PASSWORD=
GAME_ACCOUNT_CHARACTER_NAME=

########################################################################
# MEDIA GENERATION , SEE `docs/media-gen`
########################################################################

# ElevenLabs sound effects / speech generation, please use fish.audio below
ELEVENLABS_API_KEY=

# fish.audio voice acting
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL_ID=s2.1-pro-free

# MusicAPI.ai - Suno 3rd Party API for music generation
GEN_MUSIC_ENDPOINT=https://api.musicapi.ai/api/v1/sonic/create
GET_MUSIC_ENDPOINT=https://api.musicapi.ai/api/v1/sonic/task/
MUSIC_API_KEY=
MUSIC_MODEL_VERSION=sonic-v5-5


################################################################################
# AI Service Configuration
################################################################################
#
# The AI service provides intelligent NPC dialogue using either OpenAI (cloud)
# or Ollama (local). Ollama is free and runs locally, OpenAI requires an API key.
#
# QUICK START:
#   - For FREE local AI: Install Ollama, run 'ollama pull llama3.2:1b'
#   - For cloud AI: Set OPENAI_API_KEY below
#   - In-game: Use 'ai enable' to activate, 'ai' to check status
#

#-------------------------------------------------------------------------------
# General AI Settings
#-------------------------------------------------------------------------------

# Enable debug logging for AI service (0=off, 1=on)
AI_DEBUG_MODE=1

# Maximum retry attempts when API calls fail
AI_MAX_RETRIES=3

# Maximum cached AI responses
AI_MAX_CACHE_SIZE=5000

# Cache expiration time (in seconds)
AI_CACHE_EXPIRE_SECONDS=3600

# Content Filtering
AI_CONTENT_FILTER_ENABLED=false

#-------------------------------------------------------------------------------
# OpenAI Configuration (Cloud AI - Requires API Key)
#-------------------------------------------------------------------------------

# OpenAI API key (leave empty for Ollama-only mode)
OPENAI_API_KEY=

# OpenAI API Endpoint
OPENAI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# AI Model Selection for OpenAI
AI_MODEL=gpt-5.6-luna

# Maximum Response Length for OpenAI (in tokens)
AI_MAX_TOKENS=500

# Response Creativity for OpenAI (integer 0-10, divided by 10)
AI_TEMPERATURE=3

# OpenAI Request Timeout (in milliseconds)
AI_TIMEOUT_MS=30000

#-------------------------------------------------------------------------------
# Rate Limiting (Applies to OpenAI)
#-------------------------------------------------------------------------------

# Requests per minute limit
AI_REQUESTS_PER_MINUTE=60

# Requests per hour limit
AI_REQUESTS_PER_HOUR=1000

#-------------------------------------------------------------------------------
# Ollama Configuration (Local AI - Free, No API Key Required)
#-------------------------------------------------------------------------------

# Ollama API Endpoint
OLLAMA_API_ENDPOINT=http://localhost:11434/api/generate

# Ollama Model (using existing qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:7b

# Ollama Request Timeout (in milliseconds) - increased for 7B model
OLLAMA_TIMEOUT_MS=30000

# Ollama Maximum Tokens (num_predict)
OLLAMA_MAX_TOKENS=100

# Ollama Temperature (integer 0-10, divided by 10)
OLLAMA_TEMPERATURE=7

# Ollama Top-K Sampling
OLLAMA_TOP_K=40

# Ollama Top-P Sampling (integer 0-100, divided by 100)
OLLAMA_TOP_P=90

#######################################################################
# I3 Gateway Connectoin
#######################################################################

I3_GATEWAY_URL=wss://i3.ngrok.dev
I3_API_KEY=
I3_MUD_NAME=

# Email Configuration (for notifications)
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com

# Cloudflare credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Local Dev to Remote Production SSH
LOCAL_DEV_TO_REMOTE_PROD_SSH=
